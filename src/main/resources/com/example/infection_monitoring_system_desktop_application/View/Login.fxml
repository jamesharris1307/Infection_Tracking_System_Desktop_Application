<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="750" prefWidth="1250" style="-fx-background-color: B2CED6;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.infection_monitoring_system_desktop_application.Controller.LoginController">

    <children>
        <!-- Input Fields -->
        <TextField layoutX="200.0" layoutY="123.0" minHeight="30.0" minWidth="200.0" prefHeight="30.0" prefWidth="200.0" promptText="Email" />
        <PasswordField layoutX="200.0" layoutY="163.0" prefHeight="30.0" prefWidth="200.0" promptText="Password" />

              <!-- Buttons -->
        <Button layoutX="232.0" layoutY="216.0" mnemonicParsing="false" onAction="#viewRegistration" prefHeight="25.0" prefWidth="133.0" style="-fx-background-color: #96bcb4; -fx-text-fill: white;" text="Submit">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
      </Button>
        <Hyperlink layoutX="195.0" layoutY="253.0" text="Already have an Account ? Login Here" textFill="#6e6e6e" />
    </children>

</AnchorPane>
