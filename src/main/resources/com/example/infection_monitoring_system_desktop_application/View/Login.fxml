<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane minHeight="600.0" minWidth="800.0" prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: B2CED6;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.infection_monitoring_system_desktop_application.Controller.LoginController">

    <children>
        <StackPane AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

            <VBox fx:id="loginBox" alignment="CENTER" maxWidth="420" minWidth="300" prefWidth="380" spacing="25">

                <padding>
                    <Insets bottom="40" left="40" right="40" top="40" />
                </padding>

                <children>

                    <!-- Larger email field -->
                    <TextField maxWidth="Infinity" prefHeight="30.0" promptText="Email" style="-fx-font-size: 16px;" />

                    <!-- Larger password field -->
                    <PasswordField maxWidth="Infinity" prefHeight="30.0" promptText="Password" style="-fx-font-size: 16px;" />

                    <!-- Larger submit button -->
                    <Button maxWidth="Infinity" onAction="#viewRegistration" prefHeight="40.0" style="-fx-background-color: #96bcb4;                                    -fx-text-fill: white;                                    -fx-font-size: 16px;" text="Submit">
                        <font><Font name="System Bold" /></font>
                    </Button>

                    <!-- Larger hyperlink -->
                    <Hyperlink alignment="CENTER" maxWidth="Infinity" onAction="#viewRegistration" style="-fx-font-size: 15px;" text="Already have an Account? Login Here" textFill="#6e6e6e" />

                </children>
            </VBox>
        </StackPane>
    </children>
</AnchorPane>
