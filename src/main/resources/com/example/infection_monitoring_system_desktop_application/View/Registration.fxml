<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Line?>

<AnchorPane prefHeight="600" prefWidth="800" style="-fx-background-color: #B2CED6;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.infection_monitoring_system_desktop_application.Controller.RegistrationController">

    <children>
        <!-- Common Step Indicator -->
        <HBox fx:id="stepIndicator" alignment="CENTER" spacing="20" AnchorPane.bottomAnchor="250.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <StackPane>
                <Circle fx:id="step1Circle" radius="18" />
                <Label fx:id="step1Label" text="1" />
            </StackPane>
            <Line endX="50" opacity="0.5" stroke="#7c9d95" />
            <StackPane>
                <Circle fx:id="step2Circle" radius="18" />
                <Label fx:id="step2Label" text="2" />
            </StackPane>
            <Line endX="50" opacity="0.5" stroke="#7c9d95" />
            <StackPane>
                <Circle fx:id="step3Circle" radius="18" />
                <Label fx:id="step3Label" text="3" />
            </StackPane>
        </HBox>

        <!-- Page container (all pages stacked, only one visible at a time) -->
        <StackPane fx:id="pageContainer" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="80">

            <!-- Page 1: Account Details -->
            <VBox fx:id="page1" alignment="CENTER" spacing="20" visible="false">
                <TextField fx:id="emailField" maxWidth="350" prefHeight="35" promptText="Email" />
                <PasswordField fx:id="passwordField" maxWidth="350" prefHeight="35" promptText="Password" />
                <PasswordField fx:id="confirmPasswordField" maxWidth="350" prefHeight="35" promptText="Confirm Password" />
                <Button fx:id="next1Button" prefHeight="35" prefWidth="140" style="-fx-background-color: #96bcb4; -fx-text-fill: white;" text="Next" />
                <Hyperlink onAction="#viewLogin" text="Already have an Account? Login Here" textFill="#6e6e6e" />
            </VBox>

            <!-- Page 2: Personal Details -->
            <VBox fx:id="page2" alignment="CENTER" spacing="15" visible="false">
                <HBox alignment="CENTER" spacing="25">
                    <TextField fx:id="firstNameField" prefHeight="35" promptText="First Name" />
                    <TextField fx:id="lastNameField" prefHeight="35" promptText="Last Name" />
                    <DatePicker fx:id="dobPicker" prefHeight="35" promptText="Date of Birth" />
                </HBox>
                <HBox alignment="CENTER" spacing="25">
                    <TextField fx:id="address1Field" prefHeight="35" promptText="Address Line 1" />
                    <TextField fx:id="address2Field" prefHeight="35" promptText="Address Line 2" />
                    <TextField fx:id="cityField" prefHeight="35" promptText="Town / City" />
                </HBox>
                <HBox alignment="CENTER" spacing="25">
                    <TextField fx:id="countyField" prefHeight="35" promptText="County" />
                    <TextField fx:id="postcodeField" prefHeight="35" promptText="Postcode" />
                </HBox>
                <HBox alignment="CENTER" spacing="40">
                    <Button fx:id="back2Button" prefHeight="35" prefWidth="140" style="-fx-background-color: #96bcb4; -fx-text-fill: white;" text="Back" />
                    <Button fx:id="next2Button" prefHeight="35" prefWidth="140" style="-fx-background-color: #96bcb4; -fx-text-fill: white;" text="Next" />
                </HBox>
                <Hyperlink onAction="#viewLogin" text="Already have an Account? Login Here" textFill="#6e6e6e" />
            </VBox>

            <!-- Page 3: Role Details -->
            <VBox fx:id="page3" alignment="CENTER" spacing="20">
                <Label text="All roles except General Public require Verification by an Administrator" />
                <ComboBox fx:id="roleComboBox" prefWidth="150" promptText="Role" />
                <HBox alignment="CENTER" spacing="40">
                    <Button fx:id="back3Button" prefHeight="35" prefWidth="140" style="-fx-background-color: #96bcb4; -fx-text-fill: white;" text="Back" />
                    <Button fx:id="submitButton" prefHeight="35" prefWidth="140" style="-fx-background-color: #96bcb4; -fx-text-fill: white;" text="Submit" />
                </HBox>
                <Hyperlink onAction="#viewLogin" text="Already have an Account? Login Here" textFill="#6e6e6e" />
            </VBox>

        </StackPane>
    </children>
</AnchorPane>
