<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToHeight="true" fitToWidth="true"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.infection_monitoring_system_desktop_application.Controller.UpdateMedicalHistoryController">

    <VBox alignment="TOP_CENTER" style="-fx-padding: 30 20 30 20;" styleClass="root" spacing="0">

        <!-- Centering wrapper -->
        <HBox alignment="TOP_CENTER" HBox.hgrow="ALWAYS">
            <VBox alignment="TOP_CENTER" maxWidth="600" spacing="20">

                <!-- Back Button -->
                <HBox alignment="TOP_LEFT" prefHeight="44.0" prefWidth="600.0">
                    <Button fx:id="backButton" text="Back" />
                </HBox>

                <!-- Long-Term Conditions -->
                <VBox alignment="CENTER" spacing="10">
                    <Label text="Existing Long-Term Medical Conditions?" />
                    <HBox alignment="CENTER" spacing="20">
                        <RadioButton fx:id="longTermConditionsYes" text="Yes" />
                        <RadioButton fx:id="longTermConditionsNo" text="No" />
                    </HBox>
                </VBox>

                <!-- Long-Term Medications -->
                <VBox alignment="CENTER" spacing="10">
                    <Label text="Long-Term Medications?" />
                    <HBox alignment="CENTER" spacing="20">
                        <RadioButton fx:id="longTermMedicationsYes" text="Yes" />
                        <RadioButton fx:id="longTermMedicationsNo" text="No" />
                    </HBox>
                </VBox>

                <!-- Vaccinations -->
                <VBox alignment="CENTER" spacing="10">
                    <Label text="Vaccinations Up to Date?" />
                    <HBox alignment="CENTER" spacing="20">
                        <RadioButton fx:id="upToDateVaccinationsYes" text="Yes" />
                        <RadioButton fx:id="upToDateVaccinationsNo" text="No" />
                    </HBox>
                </VBox>

                <!-- Allergies -->
                <VBox alignment="CENTER" spacing="10">
                    <Label text="Any known allergies?" />
                    <HBox alignment="CENTER" spacing="20">
                        <RadioButton fx:id="allergiesYes" text="Yes" />
                        <RadioButton fx:id="allergiesNo" text="No" />
                    </HBox>
                </VBox>

                <!-- Submit Button -->
                <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
                    <Button fx:id="submitUpdateMedicalHistoryButton" onAction="#handleUpdateMedicalHistory" text="Submit" />
                </HBox>

            </VBox>
        </HBox>
    </VBox>
</ScrollPane>
