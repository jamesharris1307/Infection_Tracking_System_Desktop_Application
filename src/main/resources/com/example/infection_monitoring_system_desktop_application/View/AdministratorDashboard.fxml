<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.infection_monitoring_system_desktop_application.Controller.AdministratorDashboardController">

    <top>
        <HBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Button fx:id="logoutButton" styleClass="NoBackground" text="Logout"/>
            <ComboBox fx:id="cmbFilter" promptText="Filter By"/>
            <Button fx:id="btnApplyFilter" text="Apply Filter" onAction="#onFilterClicked"/>
            <TextField fx:id="txtSearch" onKeyReleased="#onSearchKeyTyped"/>
        </HBox>
    </top>

    <center>
        <TableView fx:id="casesTable">
            <columns>
                <TableColumn fx:id="colCaseId" text="User ID" prefWidth="80"/>
                <TableColumn fx:id="colFirstName" text="First Name" prefWidth="80"/>
                <TableColumn fx:id="colLastName" text="Last Name" prefWidth="80"/>
                <TableColumn fx:id="colEmail" text="Email" prefWidth="80"/>
                <TableColumn fx:id="colRole" text="Role" prefWidth="80"/>
                <TableColumn fx:id="colAccountStatus" text="Account Status" prefWidth="80"/>
                <TableColumn fx:id="colEditAction" text="Edit" prefWidth="80"/>
                <TableColumn fx:id="colDisableEnableAction" text="Enable/Disable" prefWidth="80"/>
                <TableColumn fx:id="colDeleteAction" text="Delete" prefWidth="80"/>
            </columns>
        </TableView>
    </center>

</BorderPane>

