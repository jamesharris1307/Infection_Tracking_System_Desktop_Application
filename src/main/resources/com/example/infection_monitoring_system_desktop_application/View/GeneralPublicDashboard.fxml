<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootScaler" xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.infection_monitoring_system_desktop_application.Controller.GeneralPublicDashboardController">

    <AnchorPane fx:id="rootContent">
        <HBox AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
              AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

            <!-- LEFT PANEL -->
            <VBox prefWidth="250" spacing="15" styleClass="sidePanel">
                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

                <HBox alignment="CENTER" spacing="20">
                    <Button fx:id="settingsButton" styleClass="NoBackground" text="Settings"/>
                    <Button fx:id="logoutButton" styleClass="NoBackground" text="Logout"/>
                </HBox>

                <Label fx:id="labelFullName" text="Label"/>
                <Label fx:id="labelEmail" text="Label"/>
            </VBox>

            <!-- CENTER CONTAINER (EMPTY) -->
            <StackPane fx:id="centerPages" HBox.hgrow="ALWAYS"/>

            <!-- RIGHT PANEL -->
            <VBox prefWidth="250" spacing="15" styleClass="sidePanel">
                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

                <VBox styleClass="panelBackground">
                    <Label style="-fx-font-weight: bold;" text="Today's Date:" />
                    <Label fx:id="lblCurrentDate" />
                </VBox>

                <VBox styleClass="panelBackground">
                    <Label style="-fx-font-weight: bold;" text="Medical History:" />
                    <Label fx:id="lblHistoryDate" />
                </VBox>

                <VBox styleClass="panelBackground">
                    <Label style="-fx-font-weight: bold;" text="Vaccination Status:" />
                    <Label fx:id="lblVaccStatus" />
                </VBox>

                <VBox styleClass="panelBackground">
                    <Label style="-fx-font-weight: bold;" text="Existing Conditions:" />
                    <Label fx:id="lblExistingConditions" />
                </VBox>
            </VBox>

        </HBox>
    </AnchorPane>

</StackPane>

