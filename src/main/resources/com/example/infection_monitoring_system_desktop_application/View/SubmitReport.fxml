<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToHeight="true" fitToWidth="true"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.infection_monitoring_system_desktop_application.Controller.SubmitReportController">

    <VBox alignment="TOP_CENTER" spacing="20" styleClass="root">

        <HBox>
            <Button fx:id="backButton" text="Back" />
        </HBox>

        <VBox spacing="10">
            <Label text="What symptoms are you experiencing?" />
            <HBox spacing="20">
                <VBox spacing="5">
                    <RadioButton fx:id="feverSymptomCheck" text="Fever" />
                    <RadioButton fx:id="coughSymptomCheck" text="Cough" />
                    <RadioButton fx:id="headacheSymptomCheck" text="Headache" />
                </VBox>

                <VBox spacing="5">
                    <RadioButton fx:id="fatigueSymptomCheck" text="Fatigue" />
                    <RadioButton fx:id="shortnessOfBreathCheck" text="Shortness of Breath" />
                    <RadioButton fx:id="lossOfSmellCheck" text="Loss of Smell" />
                </VBox>
            </HBox>
        </VBox>

        <VBox spacing="10">
            <Label text="When did your symptoms begin?" />
            <DatePicker fx:id="symptomsStartDate" />
        </VBox>

        <VBox spacing="10">
            <Label text="Symptom severity" />
            <HBox spacing="15">
                <RadioButton fx:id="MildSeverityCheck" text="Mild" />
                <RadioButton fx:id="ModerateSeverityCheck" text="Moderate" />
                <RadioButton fx:id="SevereSeverityCheck" text="Severe" />
            </HBox>
        </VBox>

        <VBox spacing="10">
            <Label text="Have symptoms worsened?" />
            <HBox spacing="20">
                <RadioButton fx:id="YesWorsenedSymptomCheck" text="Yes" />
                <RadioButton fx:id="NoWorsenedSymptomCheck" text="No" />
            </HBox>
        </VBox>

        <Button fx:id="submitReportDetailsButton" onAction="#handleSubmitReport" text="Submit" />

    </VBox>
</ScrollPane>
